
# Web3 Transaction Firewall — environment configuration template.
# Copy to .env in the repository root; both the backend and the Vite frontend
# read that single file. Real environment variables override it.

# ── Frontend ────────────────────────────────────────────────────────────────
# Leave blank to use relative URLs through the Vite dev/preview proxy (works
# from any host). Set only when the API is served from a different origin,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# ── Backend inference engine ────────────────────────────────────────────────
# Relative paths resolve against backend/.
DEFIGUARD_MODEL_PATH=models/defi_guard_model.joblib

# Block when the DeFiGuard fraud probability exceeds this value — chosen with
# backend/scripts/evaluate_model.py (see README "Model evaluation").
FRAUD_THRESHOLD=0.80

# Scoring requests (/scan, /predict, /predict/explain, /extract) allowed per
# client IP per minute; 0 disables.
RATE_LIMIT_PER_MINUTE=60

LOG_LEVEL=INFO
# Comma-separated allowed origins; restrict in production (e.g. http://localhost:5173)
CORS_ORIGINS=*

# ── Risk explanations (optional) ────────────────────────────────────────────
# Groq key enables LLM-written explanations (free: https://console.groq.com/keys)
GROQ_API_KEY=
# Groq chat model used for explanations. Groq retires models over time — see
# https://console.groq.com/docs/models if explanations report the model unavailable.
GROQ_MODEL=openai/gpt-oss-120b
# Process-wide cap on Groq calls per minute (0 disables the LLM)
LLM_MAX_CALLS_PER_MINUTE=20
