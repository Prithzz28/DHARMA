
# Web3 Transaction Firewall — environment configuration template.
# Copy to .env in the repository root; both the backend and the Vite frontend
# read that single file. Real environment variables override it.

# ── Frontend ────────────────────────────────────────────────────────────────
# Leave blank to use relative URLs through the Vite dev/preview proxy (works
# from any host). Set only when the API is served from a different origin,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# ── Backend inference engine ────────────────────────────────────────────────
# Relative paths resolve against backend/.
DEFIGUARD_MODEL_PATH=models/defi_guard_model.joblib

# Optional override of the block thresholds stored in the model (one per mode,
# selected on address-disjoint validation data during training). Leave unset
# to use the model's thresholds.
# FRAUD_THRESHOLD=0.5

# Scoring requests (/scan, /predict, /predict/explain, /extract) allowed per
# client IP per minute; 0 disables.
RATE_LIMIT_PER_MINUTE=60

LOG_LEVEL=INFO
# Comma-separated allowed origins; restrict in production (e.g. http://localhost:5173)
CORS_ORIGINS=*

# ── Risk explanations (optional) ────────────────────────────────────────────
# Groq key enables LLM-written explanations (free: https://console.groq.com/keys)
GROQ_API_KEY=
# Groq chat model used for explanations. Groq retires models over time — see
# https://console.groq.com/docs/models if explanations report the model unavailable.
GROQ_MODEL=openai/gpt-oss-120b
# Process-wide cap on Groq calls per minute (0 disables the LLM)
LLM_MAX_CALLS_PER_MINUTE=20

# ── Wallet RPC firewall (POST /rpc) ─────────────────────────────────────────
# Node that allowed transactions and all other wallet calls are forwarded to.
# May contain a provider key (Infura / Alchemy); it is never shown to clients.
UPSTREAM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Network details shown to users — must match the upstream node.
RPC_CHAIN_ID=11155111
RPC_NETWORK_NAME=Sepolia
RPC_CURRENCY_SYMBOL=SepoliaETH
RPC_EXPLORER_URL=https://sepolia.etherscan.io
# DeFiGuard probability from which the model ALONE refuses a transaction.
# 1.0 = the model only warns; blocks come from counterparty checks (its labels
# are wallet-level, so it describes the sender, not harm to the sender).
RPC_BLOCK_THRESHOLD=1.0
# Counterparty denylist (relative to backend/); built by scripts/build_flagged_addresses.py.
FLAGGED_ADDRESSES_PATH=inference_engine/resources/flagged_addresses.json
# Re-sending a blocked transaction within this many seconds forwards it (0 disables).
RPC_OVERRIDE_WINDOW_SECONDS=120
# Non-transaction RPC calls allowed per client IP per minute (0 disables).
RPC_RATE_LIMIT_PER_MINUTE=600
